# No company password is required. Local fallback works without secrets.
# Optional Gemini key: inject GEMINI_API_KEY through secure environment settings.
# Never commit a real key. Optional model override:
# GEMINI_MODEL=gemini-2.5-flash
PORT=3001
# Optional: absolute path to persistent storage
# DATA_DIR=/private/path/workspace-data
# Optional: Python interpreter with requirements.txt installed
# PYTHON=/workspace/first-app/.venv/bin/python
