#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
CONTENTS="$(cd -- "$(dirname -- "$0")/.." && pwd)"
if [ -f "$CONTENTS/Resources/workspace/desktop/mac_bootstrap.py" ]; then
  BOOTSTRAP="$CONTENTS/Resources/workspace/desktop/mac_bootstrap.py"
else
  ROOT="$(cd -- "$CONTENTS/../.." && pwd)"
  BOOTSTRAP="$ROOT/desktop/mac_app.py"
fi
PYTHON_BIN="$(command -v python3)"
if [ -z "$PYTHON_BIN" ]; then
  /usr/bin/osascript -e 'display dialog "Please install Python 3.12 or newer, then reopen M&A Group." with title "M&A Group" buttons {"OK"}'
  exit 1
fi
exec "$PYTHON_BIN" "$BOOTSTRAP"
